# Firmware version string, as the firmware Makefile and tools/build.sh made it:
#   <commit date YYYY-MM-DD>_<git describe --tags --always --long --dirty>[_<voice>]
# e.g. 2026-10-23_v2.2.4-69-gd9d7b7c_all. The board reports it (USB console 'version', INFO_FW.TXT)
# and tools/striso.py checks it after flashing. The voice suffix is left out for the default
# voice (strisy).
#
# Included by the project: striso_git_version(<out-var>) sets <out-var> to the date_describe part,
# from STRISO_GIT_VERSION if set (tools/build.sh computes it on the host: inside Docker a
# worktree's .git link points nowhere), else from git, else "nogit_v0.0.0".
#
# Run as a script at build time (cmake -P, every build, so the version follows commits without a
# reconfigure, as the Makefile did):
#   -DSOURCE_DIR=<repo> -DOUT=<header> -DSUFFIX=<_voice or empty> [-DGIT_VERSION=<override>]
#   writes '#define FWVERSION "<version>"' to OUT if it changed.

function(_striso_describe dir out)
  find_package(Git QUIET)
  # without git: still of the form the tools look for (tools/striso.py version(): _v<version>, R28)
  set(v "nogit_v0.0.0")
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" --no-pager show -s --date=short --format=%ad
                    WORKING_DIRECTORY "${dir}" OUTPUT_VARIABLE date
                    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc1 ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" --no-pager describe --tags --always --long --dirty
                    WORKING_DIRECTORY "${dir}" OUTPUT_VARIABLE desc
                    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc2 ERROR_QUIET)
    if(rc1 EQUAL 0 AND rc2 EQUAL 0)
      set(v "${date}_${desc}")
    endif()
  endif()
  set(${out} "${v}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE)
  if(GIT_VERSION)
    set(v "${GIT_VERSION}")
  else()
    _striso_describe("${SOURCE_DIR}" v)
  endif()
  set(content "// generated by cmake/StrisoVersion.cmake\n#define FWVERSION \"${v}${SUFFIX}\"\n")
  if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
  endif()
  if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
    message("firmware version: ${v}${SUFFIX}")
  endif()
  return()
endif()

function(striso_git_version out)
  if(STRISO_GIT_VERSION)
    set(${out} "${STRISO_GIT_VERSION}" PARENT_SCOPE)
    # not remembered: a later configure without it must not report a stale version
    unset(STRISO_GIT_VERSION CACHE)
    return()
  endif()
  _striso_describe("${PROJECT_SOURCE_DIR}" v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()
