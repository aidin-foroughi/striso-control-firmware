# The firmware's thread table (src/app/app_threads.h), for the build: one list entry per row,
# "id|name|stack|priority|start|source|working area|entry|margin" (the name without its quotes,
# the priority without spaces). Used by firmware_checks.cmake (the thread checks) and
# StrisoFirmware.cmake (main's stack size). Works in script mode (cmake -P) as well.
function(striso_read_threads header out)
  # (file(STRINGS) would join the macro's lines: they end in a backslash)
  file(READ "${header}" text)
  string(REGEX MATCHALL "\n *X\\([^)\n]*\\)" lines "${text}")
  set(rows "")
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^\n *X\\(([^)]*)\\)$")
      message(FATAL_ERROR "app_threads.h: can't read the row: ${line}")
    endif()
    string(REPLACE "," ";" f "${CMAKE_MATCH_1}")
    list(LENGTH f n)
    if(NOT n EQUAL 9)
      message(FATAL_ERROR "app_threads.h: a row has 9 fields, this one ${n}: ${line}")
    endif()
    set(row "")
    set(k 0)
    foreach(x IN LISTS f)
      string(STRIP "${x}" x)
      string(REPLACE "\"" "" x "${x}")
      if(k EQUAL 3)
        string(REPLACE " " "" x "${x}") # the priority: NORMALPRIO + 2 as NORMALPRIO+2
      endif()
      list(APPEND row "${x}")
      math(EXPR k "${k} + 1")
    endforeach()
    list(JOIN row "|" row)
    list(APPEND rows "${row}")
  endforeach()
  if(NOT rows)
    message(FATAL_ERROR "app_threads.h: no rows in ${header}")
  endif()
  set(${out} "${rows}" PARENT_SCOPE)
endfunction()

# one field of a row: id name stack priority start source wa entry margin
function(striso_thread_field row field out)
  set(names id name stack priority start source wa entry margin)
  list(FIND names "${field}" i)
  string(REPLACE "|" ";" r "${row}")
  list(GET r ${i} v)
  set(${out} "${v}" PARENT_SCOPE)
endfunction()
